{
  "name": "focus-timer",
  "version": "1.0.0",
  "main": "dist-electron/src/main/index.js",
  "scripts": {
    "dev:vite": "vite",
    "dev:electron": "electron dist-electron/src/main/index.js",
    "prisma:generate": "prisma generate",
    "build:vite": "npm run prisma:generate && vite build",
    "build:electron": "tsc -p tsconfig.node.json && tsc -p tsconfig.preload.json",
    "build": "npm run build:vite && npm run build:electron",
    "dist": "npm run build && electron-builder"
  },
  "build": {
    "appId": "com.focustimer.app",
    "productName": "Focus Timer",
    "icon": "assets/icon.png",
    "directories": {
      "output": "release/${version}"
    },
    "win": {
      "artifactName": "${productName}_${version}.${ext}",
      "target": "NSIS",
      "icon": "assets/icon.png"
    },
    "files": [
      "dist-electron",
      "dist",
      "assets/**/*",
      "prisma/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/@prisma/engines/migration-engine*",
      "node_modules/@prisma/engines/query*",
      "node_modules/@prisma/engines/libquery*"
    ],
    "extraResources": [
      "prisma/**/*",
      "node_modules/.prisma/**/*",
      "node_modules/@prisma/client/**/*",
      "node_modules/@prisma/engines/migration-engine*",
      "node_modules/@prisma/engines/query*",
      "node_modules/@prisma/engines/libquery*"
    ]
  },
  "keywords": [
    "electron",
    "timer",
    "estudos"
  ],
  "author": "Kauã Albuquerque",
  "license": "MIT",
  "description": "Timer de estudos com estatísticas",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "lucide-react": "^1.17.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@types/node": "^25.9.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.5.0",
    "electron": "^41.6.1",
    "electron-builder": "^25.1.7",
    "postcss": "^8.5.14",
    "prisma": "^6.19.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^6.0.3",
    "vite": "^6.4.3"
  }
}